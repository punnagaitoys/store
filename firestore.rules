rules_version = '2';

// Emulator-only rules for integration testing (task 1.3).
// The production Firestore rules (see firebase-config.js setup notes) restrict
// writes to authenticated admins; these open rules apply ONLY to the local
// Firebase Emulator Suite so the data-access-layer integration tests can run
// CRUD against products/orders/users/coupons without auth plumbing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
