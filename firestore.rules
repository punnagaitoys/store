rules_version = '2';

// Production Firestore Security Rules — Punnagai Toy Store
//
// Rule model:
//  - products / categories / banners : public reads; admin writes only
//  - orders                          : customer reads own orders; admin reads all; customer writes new orders; admin can update
//  - coupons                         : public reads (needed for coupon validation on client); admin writes
//  - users                           : customer reads/writes own doc; admin reads all
//  - audit_logs / inventory_logs     : admin only (write + read)
//  - shipping_integrations           : authenticated reads; admin writes
//
// "Admin" is defined as a signed-in Firebase Auth user whose matching Firestore
// `users` doc has `isAdmin == true`. In local/emulator mode the open rules in
// firebase.json's emulator config take precedence — these rules only govern the
// real Firestore production database.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    /** True when a valid Firebase Auth session exists. */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * True when the calling user has `isAdmin == true` in their `users` doc.
     * We read from the `users` collection rather than a custom claim so no
     * Cloud Function is needed to mint claims.
     */
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    /** True when the doc's `userId` field matches the calling user's uid. */
    function isOwner(resource) {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Products ─────────────────────────────────────────────────────────────

    match /products/{productId} {
      allow read: if true;                    // Public catalogue
      allow create, update, delete: if isAdmin();
    }

    // ── Categories ───────────────────────────────────────────────────────────

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Banners ──────────────────────────────────────────────────────────────

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Coupons ──────────────────────────────────────────────────────────────
    // Customers need to read coupon docs to validate codes client-side.
    // Only admins may create or modify coupons.

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    // - Any authenticated user can create an order (for their own userId).
    // - A customer can read their own orders; admins can read/update all.
    // - Customers may NOT update or delete — those actions are admin-only.

    match /orders/{orderId} {
      allow create: if false;               // Securely created via Cloud Functions only
      allow read:   if isAdmin() || isOwner(resource);
      allow update: if isAdmin();
      allow delete: if false;               // Orders are never deleted
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Customers may read and update their own doc; only admins can create
    // docs for other users or set isAdmin=true.

    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.isAdmin == false;
      allow update: if (isAuthenticated() && request.auth.uid == userId &&
                        // Customers cannot escalate their own privilege
                        request.resource.data.isAdmin == resource.data.isAdmin) ||
                       isAdmin();
      allow delete: if false;
    }

    // ── Inventory Logs ────────────────────────────────────────────────────────
    // Append-only from admin; admin can read.

    match /inventory_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;        // Logs are immutable
    }

    // ── Audit Logs ────────────────────────────────────────────────────────────
    // Admin-only, append-only.

    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();    // Only admins can write audit entries directly
      allow update, delete: if false;        // Logs are immutable
    }

    // ── Shipping Integrations ─────────────────────────────────────────────────

    match /shipping_integrations/{integrationId} {
      allow read:   if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    // - Any user can read reviews for any product (public social proof).
    // - Only authenticated users can create reviews; the `userId` field in the
    //   new document must match the caller's uid (enforced server-side).
    // - Purchase verification is a trusted client-side guard (Cloud Functions
    //   would be needed for a fully server-enforced check, which is out of scope).
    // - Owners can delete their own review; admins can delete any.
    // - Reviews are immutable once submitted (no updates allowed).

    match /reviews/{reviewId} {
      allow read: if true;                     // Public: anyone can read reviews
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.rating is int &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.productId is string &&
                       request.resource.data.productId != '';
      allow delete: if isAdmin() ||
                       (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if false;                  // Reviews cannot be edited after submission
    }

    // ── Deny everything else ──────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
