{
  "name": "punnagai-shop-website",
  "version": "1.0.0",
  "description": "Punnagai Toy Store static website",
  "scripts": {
    "dev": "node scripts/generate-env.js && node server.js",
    "build": "node scripts/generate-env.js && echo 'Build complete - static site ready'",
    "start": "node scripts/generate-env.js && node server.js",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "test": "jest tests/unit tests/property",
    "test:unit": "jest tests/unit",
    "test:property": "jest tests/property",
    "test:integration": "firebase emulators:exec --project demo-punnagai --only firestore,auth,storage \"jest tests/integration\"",
    "seed:firestore": "node scripts/seed-firestore.js"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.26.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "serve": "^14.2.1"
  },
  "dependencies": {
    "has-flag": "^5.0.1",
    "resolve-cwd": "^3.0.0",
    "supports-color": "^11.0.0"
  }
}
